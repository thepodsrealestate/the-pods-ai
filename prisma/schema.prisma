generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(SALES)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id                 String            @id @default(uuid())
  phone              String            @unique
  fullName           String?
  email              String?
  leadSource         String            @default("DIRECT")
  buyerLocation      String?
  purchasePurpose    String?
  budgetMin          Float?
  budgetMax          Float?
  timeline           String?
  meetingPreference  String?
  status             LeadStatus        @default(NEW)
  aiEnabled          Boolean           @default(true)
  handoffStatus      Boolean           @default(false)
  slaResponseTimeSec Int?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  bookings           Booking[]
  conversations      Conversation[]
  handoffs           Handoff[]
  attributions       LeadAttribution[]
  vouchers           Voucher[]
}

model LeadAttribution {
  id          String   @id @default(uuid())
  leadId      String
  source      String
  medium      String?
  campaign    String?
  campaignId  String?
  adSet       String?
  adId        String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String    @id @default(uuid())
  leadId    String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderType     SenderType
  content        String
  externalId     String?      @unique
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model PropertyProject {
  id            String             @id @default(uuid())
  developer     String
  projectName   String
  location      String
  startingPrice Float
  paymentPlan   String
  handover      String
  createdAt     DateTime           @default(now())
  documents     PropertyDocument[]
  facts         PropertyFact[]
}

model PropertyDocument {
  id        String          @id @default(uuid())
  projectId String
  docName   String
  fileUrl   String
  project   PropertyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PropertyFact {
  id        String          @id @default(uuid())
  projectId String
  factKey   String
  factValue String
  verified  Boolean         @default(true)
  project   PropertyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Booking {
  id              String    @id @default(uuid())
  leadId          String
  calendarEventId String    @unique
  meetingTime     DateTime
  location        String    @default("The Pods, Bluewaters Island, Dubai")
  status          String    @default("CONFIRMED")
  createdAt       DateTime  @default(now())
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vouchers        Voucher[]
}

model Voucher {
  id        String   @id @default(uuid())
  leadId    String
  bookingId String
  code      String   @unique
  valueAed  Float    @default(20000)
  issuedAt  DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Handoff {
  id        String   @id @default(uuid())
  leadId    String
  reason    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  eventType String
  payload   Json
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   Json
  createdAt DateTime @default(now())
}

model SystemEvent {
  id        String   @id @default(uuid())
  eventType String
  message   String
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  SALES
  VIEWER
}

enum LeadStatus {
  NEW
  AI_ENGAGED
  QUALIFIED
  MEETING_BOOKED
  CLOSED
}

enum SenderType {
  LEAD
  AI
  HUMAN_AGENT
  SYSTEM
}
